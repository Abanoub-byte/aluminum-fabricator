<svg xmlns="http://www.w3.org/2000/svg" width="1600" height="900" viewBox="0 0 1600 900">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#1c1510"/>
      <stop offset="100%" style="stop-color:#5c3618"/>
    </linearGradient>
    <pattern id="wood" x="0" y="0" width="60" height="900" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="2" y2="900" stroke="rgba(255,255,255,0.03)" stroke-width="1.5"/>
      <line x1="15" y1="0" x2="13" y2="900" stroke="rgba(255,255,255,0.02)" stroke-width="2"/>
      <line x1="35" y1="0" x2="38" y2="900" stroke="rgba(255,255,255,0.025)" stroke-width="1"/>
      <line x1="52" y1="0" x2="55" y2="900" stroke="rgba(255,255,255,0.015)" stroke-width="1"/>
    </pattern>
  </defs>
  <rect width="1600" height="900" fill="url(#g)"/>
  <rect width="1600" height="900" fill="url(#wood)"/>
  <circle cx="800" cy="420" r="300" fill="none" stroke="rgba(196,154,74,0.08)" stroke-width="60"/>
  <circle cx="800" cy="420" r="200" fill="none" stroke="rgba(196,154,74,0.06)" stroke-width="40"/>
