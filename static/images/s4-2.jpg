<svg xmlns="http://www.w3.org/2000/svg" width="800" height="600" viewBox="0 0 800 600">
  <defs>
    <linearGradient id="g" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5c3a1e"/>
      <stop offset="100%" style="stop-color:#9a6640"/>
    </linearGradient>
    <!-- wood grain lines -->
    <pattern id="wood" x="0" y="0" width="40" height="400" patternUnits="userSpaceOnUse">
      <line x1="0" y1="0" x2="2" y2="400" stroke="rgba(255,255,255,0.04)" stroke-width="1"/>
      <line x1="10" y1="0" x2="12" y2="400" stroke="rgba(255,255,255,0.03)" stroke-width="1.5"/>
      <line x1="24" y1="0" x2="22" y2="400" stroke="rgba(255,255,255,0.02)" stroke-width="1"/>
      <line x1="35" y1="0" x2="38" y2="400" stroke="rgba(255,255,255,0.05)" stroke-width="0.5"/>
    </pattern>
  </defs>
  <rect width="800" height="600" fill="url(#g)"/>
  <rect width="800" height="600" fill="url(#wood)"/>
  <!-- decorative frame -->
  <rect x="20" y="20" width="760" height="560" fill="none" stroke="rgba(255,255,255,0.12)" stroke-width="1"/>
  <rect x="30" y="30" width="740" height="540" fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="0.5"/>
  <!-- center diamond -->
  <polygon points="400,220 440,270 400,320 360,270" fill="none" stroke="rgba(255,255,255,0.25)" stroke-width="1.5"/>
  <!-- title text -->
  <text x="400" y="380" text-anchor="middle" font-family="serif" font-size="22" fill="rgba(255,255,255,0.7)" font-weight="600">تقاطيع</text>
  <text x="400" y="410" text-anchor="middle" font-family="serif" font-size="13" fill="rgba(255,255,255,0.4)">Add your image here</text>
</svg>
